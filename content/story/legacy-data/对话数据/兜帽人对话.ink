// ============================================
// 兜帽人对话 | Ink Script
// 根据可可露好感度决定对话内容
// ============================================

// 从主脚本读取的变量（需要外部传入）
VAR Cocolu_Affinity = 0
VAR Player_Has_Key = false

// 兜帽人对话进度
VAR HoodedMan_Daily_Talked = false
VAR HoodedMan_Gift_Given = false

// 阶段对话标记
VAR HoodedMan_Stage1_Done = false
VAR HoodedMan_Stage2_Done = false
VAR HoodedMan_Stage3_Done = false
VAR HoodedMan_Stage4_Done = false
VAR HoodedMan_Stage5_Done = false

-> hooded_man_main

// ============================================
// 主入口 - 根据好感度分流
// ============================================

=== hooded_man_main ===
{HoodedMan_Daily_Talked:
    // [场景] 兜帽人看到你走近，微微点头。
    兜帽人："……今天已经聊过了。"
    兜帽人："让我一个人待会儿。"
    + [离开]
        -> END
}

// [场景] 你走向角落的兜帽人。
// [场景] 他抬起头，兜帽下是一张苍老而疲惫的脸。

// 根据可可露好感度决定对话
// 仇人阶段（-50以下）
{Cocolu_Affinity < -50:
    -> stage_enemy
}
// 默认阶段（-50到50）
{Cocolu_Affinity >= -50 && Cocolu_Affinity < 50:
    -> stage_default
}
// 朋友阶段（50到150）
{Cocolu_Affinity >= 50 && Cocolu_Affinity < 150:
    -> stage_friend
}
// 亲密阶段（150到250）
{Cocolu_Affinity >= 150 && Cocolu_Affinity < 250:
    -> stage_close
}
// 恋人阶段（250以上）
{Cocolu_Affinity >= 250:
    -> stage_lover
}

// ============================================
// 仇人阶段对话
// ============================================

=== stage_enemy ===
// [场景] 兜帽人看了你一眼。
// [场景] 然后看向吧台后的可可露。
// [场景] 她的表情很冷淡。

兜帽人："她看起来……不太开心。"

+ [关你什么事]
    你："关你什么事。"
    兜帽人："……"
    兜帽人："是啊。"
    兜帽人："关我什么事呢。"
    -> stage_enemy_end

+ [是啊]
    你："是啊。"
    // [场景] 兜帽人沉默了一会儿。
    -> stage_enemy_end

=== stage_enemy_end ===
兜帽人："你……"
兜帽人："做了什么让她不高兴的事吗？"

+ [没有]
    你："没有。"
    // [场景] 兜帽人看着你，眼神复杂。
    兜帽人："……"
    -> stage_enemy_finish

+ [不关你的事]
    你："不关你的事。"
    兜帽人："……是吗。"
    -> stage_enemy_finish

=== stage_enemy_finish ===
兜帽人："好好对她。"
兜帽人："她……不应该不开心。"

// [场景] 他放下酒钱，站起来。
// [场景] 经过吧台时，他停下脚步。
// [场景] 看着可可露冷淡的表情。
// [场景] 叹了口气。
// [场景] 然后离开了。

~ HoodedMan_Daily_Talked = true

-> END

// ============================================
// 默认阶段对话
// ============================================

=== stage_default ===
{HoodedMan_Stage1_Done:
    -> stage_default_repeat
}

// [场景] 兜帽人看着你，有些戒备。

兜帽人："……你是？"

+ [我是这里的常客]
    你："我是这里的常客。"
    兜帽人："……哦。"
    -> stage_default_continue

+ [你经常来这里吗？]
    你："你经常来这里吗？"
    兜帽人："……偶尔。"
    -> stage_default_continue

=== stage_default_continue ===
// [场景] 他看了一眼吧台后的可可露。
// [场景] 然后迅速移开目光。

兜帽人："那个调酒师……"
兜帽人："她调的酒很好喝。"

+ [你认识她？]
    你："你认识她？"
    兜帽人："……不。"
    兜帽人："只是一个普通客人。"
    -> stage_default_question

+ [是吗]
    你："是吗。"
    -> stage_default_question

=== stage_default_question ===
兜帽人："她看起来……过得还好吗？"

+ [你为什么想知道？]
    你："你为什么想知道？"
    兜帽人："……没什么。"
    兜帽人："随便问问。"
    -> stage_default_end

+ [还行吧]
    你："还行吧。"
    兜帽人："……那就好。"
    -> stage_default_end

=== stage_default_end ===
// [场景] 兜帽人端起酒杯，喝了一口。
兜帽人："……谢谢你告诉我。"

// [场景] 他放下酒钱，站起来。
// [场景] 经过吧台时，他看了可可露一眼。
// [场景] 然后快步离开。

~ HoodedMan_Stage1_Done = true
~ HoodedMan_Daily_Talked = true

-> END

=== stage_default_repeat ===
// [场景] 兜帽人看到你，点点头。

兜帽人："又来了。"
兜帽人："她……还好吗？"

+ [还行]
    你："还行。"
    兜帽人："……嗯。"
    -> stage_default_repeat_end

+ [你为什么总问这个？]
    你："你为什么总问这个？"
    兜帽人："……"
    兜帽人："没什么。"
    -> stage_default_repeat_end

=== stage_default_repeat_end ===
// [场景] 他看了可可露一眼，然后离开。

~ HoodedMan_Daily_Talked = true

-> END

// ============================================
// 朋友阶段对话
// ============================================

=== stage_friend ===
{HoodedMan_Stage2_Done:
    -> stage_friend_repeat
}

// [场景] 兜帽人看到你，表情有些复杂。

兜帽人："又是你。"
兜帽人："你……和她关系不错？"

+ [算是朋友吧]
    你："算是朋友吧。"
    兜帽人："朋友……"
    兜帽人："那很好。"
    -> stage_friend_continue

+ [怎么了？]
    你："怎么了？"
    兜帽人："没什么。"
    -> stage_friend_continue

=== stage_friend_continue ===
兜帽人："她有没有提过……"
兜帽人："她的家人？"

+ [她说她没有家人]
    你："她说她没有家人。"
    你："小时候被抛弃了。"
    // [场景] 兜帽人的手微微颤抖。
    兜帽人："……是吗。"
    -> stage_friend_react

+ [你为什么想知道？]
    你："你为什么想知道？"
    兜帽人："……好奇而已。"
    -> stage_friend_react

=== stage_friend_react ===
兜帽人："一个人经营酒馆……"
兜帽人："一定很辛苦吧。"

兜帽人："如果她有家人……"
兜帽人："应该会轻松一点。"

// [场景] 他的声音有些沙哑。

兜帽人："……算了。"
兜帽人："当我没说。"

// [场景] 他放下酒钱，站起来。

~ HoodedMan_Stage2_Done = true
~ HoodedMan_Daily_Talked = true

-> END

=== stage_friend_repeat ===
// [场景] 兜帽人看到你。

兜帽人："你们……还是朋友吗？"

+ [是的]
    你："是的。"
    兜帽人："……那就好。"
    -> stage_friend_repeat_end

+ [我们关系更好了]
    你："我们关系更好了。"
    // [场景] 兜帽人看着你，眼神复杂。
    兜帽人："……是吗。"
    兜帽人："好好对她。"
    -> stage_friend_repeat_end

=== stage_friend_repeat_end ===
// [场景] 他看了可可露一眼。

兜帽人："她能有朋友……"
兜帽人："我很高兴。"

// [场景] 他离开了。

~ HoodedMan_Daily_Talked = true

-> END

// ============================================
// 亲密阶段对话
// ============================================

=== stage_close ===
{HoodedMan_Stage3_Done:
    -> stage_close_repeat
}

// [场景] 兜帽人今天看起来更加憔悴。
// [场景] 他一直在看可可露。

// [场景] 你在他对面坐下。

兜帽人："……"
兜帽人："你和她……很亲近？"

+ [是的]
    你："是的。"
    -> stage_close_continue

+ [你怎么知道？]
    你："你怎么知道？"
    兜帽人："看得出来。"
    兜帽人："她看你的眼神……不一样了。"
    -> stage_close_continue

=== stage_close_continue ===
// [场景] 兜帽人沉默了很久。

兜帽人："有些事……"
兜帽人："做错了就回不去了。"

+ [什么意思？]
    你："什么意思？"
    -> stage_close_past

+ [你做错了什么？]
    你："你做错了什么？"
    -> stage_close_past

=== stage_close_past ===
兜帽人："如果当初……"
兜帽人："做了不一样的选择……"
兜帽人："也许一切都会不同。"

// [场景] 他的手微微颤抖。

兜帽人："但我没有资格后悔。"
兜帽人："更没有资格出现在她面前。"

+ [她？你说的是可可露吗？]
    你："她？你说的是可可露吗？"
    // [场景] 兜帽人猛地站起来。
    兜帽人："……我该走了。"
    -> stage_close_end

+ [你到底是谁？]
    你："你到底是谁？"
    // [场景] 兜帽人避开你的目光。
    兜帽人："……没人。"
    -> stage_close_end

=== stage_close_end ===
// [场景] 他快步走向门口。

// [场景] 经过吧台时，可可露抬起头。
可可露："客人，您的酒钱……"

// [场景] 兜帽人停下脚步。
// [场景] 他从口袋里掏出钱，放在吧台上。
// [场景] 手在颤抖。

// [场景] 可可露看着他的背影，若有所思。

~ HoodedMan_Stage3_Done = true
~ HoodedMan_Daily_Talked = true

-> END

=== stage_close_repeat ===
// [场景] 兜帽人看到你。
// [场景] 他的眼眶有些红。

兜帽人："你们……还好吗？"

+ [很好]
    你："很好。"
    兜帽人："……"
    -> stage_close_repeat_end

+ [她有时候会提起家人]
    你："她有时候会提起家人。"
    // [场景] 兜帽人身体一僵。
    兜帽人："……她说什么了？"
    你："她说不理解为什么被抛弃。"
    兜帽人："……"
    兜帽人："是吗……"
    -> stage_close_repeat_end

=== stage_close_repeat_end ===
兜帽人："好好对她。"
兜帽人："她值得……被好好对待。"

// [场景] 他匆匆离开。

~ HoodedMan_Daily_Talked = true

-> END

// ============================================
// 恋人阶段对话
// ============================================

=== stage_lover ===
{HoodedMan_Stage4_Done:
    {HoodedMan_Gift_Given:
        -> stage_lover_after_gift
    }
    -> stage_lover_gift
}

// [场景] 兜帽人今天喝了很多酒。
// [场景] 桌上放着好几个空杯子。
// [场景] 他的眼眶红红的。

// [场景] 你在他对面坐下。

兜帽人："……又是你。"

+ [你喝了很多]
    你："你喝了很多。"
    兜帽人："……嗯。"
    -> stage_lover_continue

+ [你还好吗？]
    你："你还好吗？"
    兜帽人："不好。"
    兜帽人："从来就没好过。"
    -> stage_lover_continue

=== stage_lover_continue ===
// [场景] 兜帽人看向吧台。
// [场景] 可可露正在和你说笑。
// [场景] 她的表情很温柔。

兜帽人："你们……"
兜帽人："在一起了？"

+ [是的]
    你："是的。"
    -> stage_lover_react

+ [算是吧]
    你："算是吧。"
    -> stage_lover_react

=== stage_lover_react ===
// [场景] 兜帽人沉默了很久。

兜帽人："你知道吗。"
兜帽人："世界上最残忍的事……"
兜帽人："不是被抛弃。"
兜帽人："是明明可以不抛弃……"
兜帽人："却选择了抛弃。"

// [场景] 他的声音开始颤抖。

兜帽人："然后发现……"
兜帽人："自己错了。"
兜帽人："大错特错。"

兜帽人："但已经太晚了。"

+ [你在说什么？]
    你："你在说什么？"
    -> stage_lover_confession

+ [你抛弃过谁？]
    你："你抛弃过谁？"
    -> stage_lover_confession

=== stage_lover_confession ===
// [场景] 兜帽人看向吧台后的可可露。
// [场景] 眼泪从他的眼眶里滑落。

兜帽人："那个孩子……"
兜帽人："她应该恨我。"
兜帽人："她有权利恨我。"

兜帽人："但我连被她恨的资格都没有。"
兜帽人："因为她根本不知道我是谁。"

+ [你是她的父亲？]
    你："你是她的父亲？"
    -> stage_lover_truth

+ [……]
    // [场景] 你沉默地看着他。
    -> stage_lover_truth

=== stage_lover_truth ===
// [场景] 兜帽人抬起头，看着你。
// [场景] 泪流满面。

兜帽人："……是的。"
兜帽人："我是可可露的父亲。"

// [场景] 他深吸一口气。

兜帽人："二十年前……"
兜帽人："她生了那个病。"
兜帽人："医生说……活不长。"
兜帽人："我害怕了。"
兜帽人："害怕看着她慢慢死去。"
兜帽人："所以……"
兜帽人："我丢下了她。"
兜帽人："像个懦夫一样……"
兜帽人："逃走了。"

// [场景] 他捂住脸，肩膀剧烈颤抖。

兜帽人："后来我后悔了。"
兜帽人："疯狂地后悔。"
兜帽人："我到处找她。"
兜帽人："找了十几年。"
兜帽人："终于找到了这里。"

兜帽人："但是……"
兜帽人："我不敢认她。"
兜帽人："我怕她恨我。"
兜帽人："我怕……"
兜帽人："我怕她看我的眼神……"
兜帽人："是厌恶。"

+ [她不会的]
    你："她不会的。"
    你："她一直在等。"
    兜帽人："什么？"
    你："她说不理解为什么被抛弃。"
    你："但她从来没说过恨。"
    兜帽人："真的吗……"
    -> stage_lover_ending

+ [你应该告诉她]
    你："你应该告诉她。"
    // [场景] 兜帽人摇头。
    兜帽人："不……"
    兜帽人："我没有那个资格。"
    -> stage_lover_ending

=== stage_lover_ending ===
// [场景] 兜帽人擦了擦眼泪。

兜帽人："你……愿意帮我一个忙吗？"

+ [什么忙？]
    你："什么忙？"
    -> stage_lover_request

+ [说吧]
    你："说吧。"
    -> stage_lover_request

=== stage_lover_request ===
兜帽人："不要告诉她……"
兜帽人："我是谁。"

兜帽人："让她继续恨那个抛弃她的人吧。"
兜帽人："不要让她知道……"
兜帽人："那个人一直在偷偷看着她。"

兜帽人："这样太残忍了。"
兜帽人："对她来说……"
兜帽人："不知道真相……"
兜帽人："也许更好。"

+ [我不能替你做这个决定]
    你："我不能替你做这个决定。"
    你："但我会尊重你的选择。"
    兜帽人："……谢谢你。"
    -> stage_lover_gift_scene

+ [好]
    你："好。"
    兜帽人："谢谢你……"
    -> stage_lover_gift_scene

+ [你应该亲自告诉她]
    你："你应该亲自告诉她。"
    // [场景] 兜帽人沉默了很久。
    兜帽人："……也许有一天。"
    兜帽人："等我鼓起勇气。"
    -> stage_lover_gift_scene

=== stage_lover_gift_scene ===
// [场景] 兜帽人从怀里掏出一个包裹。

兜帽人："这个……给你。"

// [场景] 你打开包裹。
// [场景] 里面是一枚古老的戒指，还有一袋金币。

兜帽人："那枚戒指……"
兜帽人："是她母亲的遗物。"
兜帽人："本来应该留给可可露的。"
兜帽人："但我……没有资格亲手交给她。"

兜帽人："还有这些金币。"
兜帽人："是我这些年攒下的。"
兜帽人："本来想……如果她需要什么……"
兜帽人："但我始终没有勇气。"

兜帽人："现在……"
兜帽人："交给你吧。"
兜帽人："你会好好照顾她的。"

+ [我会的]
    你："我会的。"
    -> stage_lover_final

+ [你真的不告诉她吗？]
    你："你真的不告诉她吗？"
    兜帽人："也许……有一天。"
    兜帽人："等她更幸福的时候。"
    -> stage_lover_final

=== stage_lover_final ===
【获得500金币】
【获得道具：母亲的戒指】

// [场景] 兜帽人站起来。
// [场景] 他走向门口，脚步有些踉跄。

// [场景] 经过吧台时，他停下脚步。
// [场景] 看着可可露。

// [场景] 可可露抬起头，感觉到他的目光。
可可露："客人？"

// [场景] 兜帽人张了张嘴。
// [场景] 泪水再次涌出。

兜帽人："……保重。"

// [场景] 他转身，快步离开。
// [场景] 没有回头。

// [场景] 可可露看着他的背影，若有所思。
可可露："那个人……"
可可露："好奇怪。"
可可露："他哭了吗？"

你："……大概吧。"

可可露："为什么呢？"

// [场景] 你看着门口的方向。
// [场景] 那个佝偻的背影已经消失在夜色中。

你："……也许是想起了什么吧。"

~ HoodedMan_Stage4_Done = true
~ HoodedMan_Gift_Given = true
~ HoodedMan_Daily_Talked = true

-> END

// ============================================
// 恋人阶段 - 送礼后再次对话
// ============================================

=== stage_lover_gift ===
// [场景] 兜帽人看到你，微微点头。

兜帽人："你们……还好吗？"

+ [很好]
    你："很好。"
    兜帽人："那就好。"
    -> stage_lover_gift_continue

+ [她很幸福]
    你："她很幸福。"
    兜帽人："……谢谢你。"
    -> stage_lover_gift_continue

=== stage_lover_gift_continue ===
兜帽人："那枚戒指……"
兜帽人："你给她了吗？"

+ [还没有]
    你："还没有。"
    兜帽人："……找个合适的时机吧。"
    -> stage_lover_gift_end

+ [给了]
    你："给了。"
    兜帽人："她……喜欢吗？"
    你："很喜欢。"
    兜帽人："那就好……"
    兜帽人："那就好……"
    -> stage_lover_gift_end

=== stage_lover_gift_end ===
// [场景] 兜帽人站起来。

兜帽人："我……"
兜帽人："可能不会再来了。"

+ [为什么？]
    你："为什么？"
    兜帽人："看到她幸福……"
    兜帽人："我就放心了。"
    兜帽人："没有必要再留在这里。"
    -> stage_lover_farewell

+ [她会想你的]
    你："她会想你的。"
    你："虽然她不知道你是谁。"
    兜帽人："也许吧。"
    -> stage_lover_farewell

=== stage_lover_farewell ===
// [场景] 兜帽人看向吧台。
// [场景] 可可露正在认真地擦拭酒杯。

兜帽人："如果有来生……"
兜帽人："我一定不会再……"
兜帽人："犯同样的错误。"

// [场景] 他走向门口。

兜帽人："好好照顾她。"
兜帽人："拜托了。"

// [场景] 他推开门。
// [场景] 消失在夜色中。

~ HoodedMan_Daily_Talked = true

